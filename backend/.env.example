# TerraAI Backend - Environment Configuration
# Copy this file to .env and set your credentials

# 1. Supabase PostgreSQL Connection String (Transaction Pooler or Direct Connection)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres

# 2. Supabase Project JWT Secret (found in Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-jwt-secret-key-here

# 3. Groq API key (https://console.groq.com) for AI parsing and explanations
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b
