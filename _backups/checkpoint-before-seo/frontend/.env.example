# TerraAI Frontend - Supabase Auth Environment Configuration
# Copy this file to .env and provide your Supabase project credentials

# 1. Your Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Your Supabase Project Anon Public API Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key-here

# 3. Optional: Backend API URL
VITE_API_URL=http://127.0.0.1:8000
